# Database Configuration
# In production, use your actual PostgreSQL database URL
DATABASE_URL=postgresql://user:password@localhost/archetype

# Authentication
# Run `openssl rand -hex 32` to generate a secure secret key
SECRET_KEY=super-secret-default-key-do-not-use-in-prod

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:8081,http://localhost:3000
