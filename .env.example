# ── Environment ─────────────────────────────────────────────
# "production" (default) | "development" | "test"
ENV=development

# Set to true to enable dev-only features (OTP dev_code, etc.)
DEBUG=false

# ── Database ───────────────────────────────────────────────
# In production, use your actual PostgreSQL database URL
DATABASE_URL=postgresql://user:password@localhost/archetype

# ── Authentication ─────────────────────────────────────────
# REQUIRED — Run `openssl rand -hex 32` to generate a secure secret key
# App will REFUSE TO START without this in production mode
SECRET_KEY=

# JWT settings (optional, sensible defaults)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:8081,http://localhost:3000

# ── Mobile (Expo) ─────────────────────────────────────────
# Set in mobile/.env or as env var for Expo builds
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── OAuth (optional, for social login) ─────────────────────
# APPLE_BUNDLE_ID=com.archetype.app
# GOOGLE_CLIENT_ID=your-google-client-id
